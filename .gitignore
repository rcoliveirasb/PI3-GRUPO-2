# Ignora os dados baixados (pesados: imagens de TC, ~23GB) e os arquivos
# grandes do dataset publico (candidates.csv, annotations.csv -- baixaveis via
# scripts/download_luna16_subset.py). Mantem os manifestos pequenos em
# data/luna16/_lists/ e os artefatos gerados pelo grupo (splits, resultados,
# modelo treinado) necessarios para rodar/reproduzir o pipeline sem re-treinar.
data/*
!data/luna16/
data/luna16/*
!data/luna16/_lists/
!data/luna16/split_full.csv
!data/luna16/split_subset0.csv
!data/luna16/selecao_subset0.csv
!data/luna16/subset0_headers.csv
!data/luna16/piloto_resultados_sprint3.csv
!data/luna16/sprint4_baseline_test.csv
!data/luna16/sprint4_region_growing_test.csv
