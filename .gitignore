!data/luna16/sprint8_resultados.csv
!data/luna16/sprint8b_resultados.csv
!data/luna16/sprint8c_resultados_finais.csv
!data/luna16/sprint_unet_test.csv
!data/luna16/classificador_fp_reduction.joblib

